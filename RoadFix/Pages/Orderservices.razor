@page "/services"
@using Postgrest.Models
@using Supabase
@inject Supabase.Client supabase
@using Microsoft.VisualBasic
@inject IConfiguration Configuration
@using RoadFix.Services
@using System.ComponentModel.DataAnnotations.Schema
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations
@inject IJSRuntime JSRuntime


<PageTitle>Order Services - RoadFix</PageTitle>

<div class="container my-5">
    <h1 class="text-center mb-4">Request Road Repair Services</h1>
    <p class="text-center mb-5">Fill out the form below to request pothole detection and repair services. We'll get back to you within 24 hours.</p>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card-body">
                    <mapbox-search-box id="roadfix-search" access-token="pk.eyJ1Ijoicm9hZHNmaXgiLCJhIjoiY21ucmp3ZHExMDM2YTJxcXl6cHQwZDYzNiJ9.HLly-ID-5Sftsfo_KBoMjQ" placeholder="Let's find Pothole address..." proximity="ip"  ></mapbox-search-box>
                                     
                </div>
               

                
            
            
            <div id="map" style="width: 100%; height: 450px; border-radius: 12px; border: 1px solid #ccc;">
                
                </div>
                
            <div class="card">
                
                


            <EditForm Model="@recOrder" OnSubmit="LogOrder" FormName="oderForm">
                <DataAnnotationsValidator/>
                
                <div class="alert alert-info">
                    Captured Location: @(string.IsNullOrEmpty(recOrder.Address) ? "Move the map pin to select" : recOrder.Address)
                </div>
                <div class="mb-3">
                            <label for="name" class="form-label">Full Name *</label>
                            <input type="text" class="form-control" id="name" required>
                        </div>
                            
                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address *</label>
                            <input type="email" class="form-control" id="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="phone" class="form-label">Phone Number *</label>
                            <InputText id="phone" type="tel" @bind-Value="recOrder.phone" placeholder="081-234-5678"  required/> 
                            <ValidationMessage For="@(() =>recOrder.phone)" />
                        </div>
                         <div class="mb-3">
                            <label for="serviceType" class="form-label">Service Type *</label>
                            <InputSelect @bind-Value="recOrder.Service_Type" class="form-select" id="serviceType" required>
                                <option value="">Select a service</option>
                                <option value="detection">Pothole Detection Only</option>
                                <option value="repair">Pothole Repair</option>
                                <option value="assessment">Road Assessment</option>
                                <option value="emergency">Emergency Repair (24/7)</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => recOrder.Service_Type)"/>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description of Issue</label>
                            <InputTextArea @bind-Value="recOrder.issueDescription" class="form-control" id="description" rows="4" placeholder="Please describe the location, size, and severity of the potholes or road issues..." />
                            
                            <ValidationMessage For="@(() => recOrder.issueDescription)"/>
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox @bind-Value="recOrder.Insurance" class="form-check-input" id="insurance" />
                            <label class="form-check-label" for="insurance">
                                This is for insurance claim purposes
                            </label>
                            
                            <ValidationMessage For="@(() => recOrder.Insurance)"/>
                        </div>
                        <div class="text-center">
                            <button  type="submit" class="btn btn-primary btn-lg me-3", >Submit Request</button>
                            <NavLink href="/dashboard" class="btn btn-outline-secondary btn-lg">Back to Home</NavLink>
                        </div>
   
            </EditForm>
                
            </div>
        </div>

    </div>
</div>

@code {
     private string Name = string.Empty;
    private string CellNumber = string.Empty;
    
    private String Address {get; set;} = string.Empty;
    private String searchQuery = string.Empty;
    private string currentAddress = string.Empty;
 
    
    
    [SupplyParameterFromForm] 

    private recordOrder recOrder {get; set;} = new recordOrder ();         

    private async Task LogOrder(){
            var model = new Order
            {
                Address= recOrder.Address,
                Service_Type = recOrder.Service_Type,
                issueDescription = recOrder.issueDescription,
                Insurance = recOrder.Insurance
                };

                try 
    {
       // 2. Write to Supabase 
        await supabase.From<Order>().Insert(model);

        // 3. Redirect to the dashboard or a success page
        Navigation.NavigateTo("/Historicservice");
    }
    catch (Exception )
    {
        // Handle potential errors here (e.g., database offline)
        Navigation.NavigateTo("/dashboard");
    }
             

    }

   public class recordOrder(){
        
        public string phone { get; set; } = string.Empty; 

      
  
        public string Address {get; set;} = string.Empty;

        public string Service_Type {get; set;} = string.Empty;
        public string issueDescription {get; set;} = string.Empty;

        public bool Insurance {get; set;} = false;
        public bool newsletter {get; set;} = false;

    }
    [Table("Order")]
    class Order :BaseModel{
        [Column("Address")]
        public string Address {get; set;} = string.Empty;

        [Column("ServiceType")]
        public string Service_Type {get; set;} = string.Empty;

        [Column("issueDescription")]
        public string issueDescription {get; set;} = string.Empty;

        [Column("insurance")]
        public bool Insurance {get; set;} = false;
        
    }
//private string MapboxToken = "pk.eyJ1Ijoicm9hZHNmaXgiLCJhIjoiY21ucmp3ZHExMDM2YTJxcXl6cHQwZDYzNiJ9.HLly-ID-5Sftsfo_KBoMjQ";
    private string? _mapboxtoken;
private DotNetObjectReference<Orderservices>? objRef;
protected override async Task OnAfterRenderAsync(bool firstRender)

    {
        _mapboxtoken = Configuration["MapboxToken"];
        if (firstRender)
        {
            // Give the browser a moment to ensure the 'map' div is rendered
            await Task.Delay(300);
             objRef = DotNetObjectReference.Create(this);
   
            await JSRuntime.InvokeVoidAsync("initRoadfixMap", objRef,_mapboxtoken);
        }
    }   
    public void Dispose() => objRef?.Dispose();
    [JSInvokable]
 

public  void ReceiveAddress(string address)
    {
        // This method can be used to receive data from JavaScript if needed
            recOrder.Address = address;
            

            StateHasChanged();

           

    }

}