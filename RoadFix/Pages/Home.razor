@page "/"


<PageTitle>RoadFix - Professional Pothole Repair Services</PageTitle>

<div class="hero-section">
    <div class="container">
       <!-- <NavLink hreg="/order-services" class="btn btn-primary btn-lg me-3">Order</NavLink>-->
        
        <h1 class="display-4 fw-bold text-center mb-4">Report a pothole today, Let's get it fixed.</h1>
        <p class="lead text-center mb-4">Professional Pothole Detection and Repair Services</p>
        <p class="text-center mb-5">We specialize in identifying, assessing, and repairing potholes to ensure safe and smooth roads for our community.</p>
        <div class="text-center">
