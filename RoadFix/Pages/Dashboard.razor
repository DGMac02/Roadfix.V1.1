            <NavLink href="/Historicservice" class="btn-quote">Service History</NavLink>

        </div>

    </nav>
    <div class="kpi-grid">
        <div class="card blue-border">
            <label>Total Repaired</label>
            <div class="value">1,209<span>m³</span></div>
