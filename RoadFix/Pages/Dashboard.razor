@page "/dashboard"
<div class="dashboard-container">
    <nav class="top-nav">
        <div class="logo-area">
            <div class="tech-icon">⚙️</div>
            <h1>ROADS<span class="blue-text">FIX</span> <small>SMART OPS</small></h1>
        </div>
        <div class="nav-actions">
            <span class="status-indicator">● LIVE OPS: BLOEMFONTEIN</span>
