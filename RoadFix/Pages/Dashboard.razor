            <p>Inventory Level: Stable</p>
        </div>
        <div class="card blue-border">
            <label>Community Savings</label>
            <div class="value">R2.4M</div>
            <p>Estimated Damage Avoided</p>
        </div>
    </div>

    <div class="main-content">
